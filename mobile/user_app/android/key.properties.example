# Android Release Signing Configuration Example for Daleel User App
# Copy this file to `mobile/user_app/android/key.properties` and fill in your secure credentials
# NEVER commit key.properties or .jks keystore files into version control

storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyPassword=YOUR_KEY_PASSWORD_HERE
keyAlias=daleel-user-release
storeFile=../keystores/daleel_user_release.jks
